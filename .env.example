# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/expressfly

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# Razorpay (Test Mode keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Server
PORT=4000

# Custom domains (seller-connected domains like shop.theirbrand.com)
# Comma-separated list of domains sellers are NOT allowed to claim as a
# custom domain (your own platform domain(s)).
PLATFORM_ROOT_DOMAINS=expressfly.app,expressfly.com,localhost
# The hostname sellers should point a CNAME/ALIAS record at.
PLATFORM_CNAME_TARGET=stores.expressfly.app

# Twilio (real-world OTP delivery via SMS — https://console.twilio.com)
# Leave blank for local dev: OTP codes will be printed to this terminal instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Shared secret for the manual KYC review endpoints (GET/POST /api/seller/kyc/...)
# until a proper admin panel exists. Send as header: x-admin-secret
ADMIN_SECRET=change_this_to_a_long_random_string

# PAYMENTS_MOCK_MODE=true is already used by sellerPaymentRoutes.js for local
# Razorpay Route onboarding without hitting the real API.
PAYMENTS_MOCK_MODE=false


ENCRYPTION_KEY=7f3c9a1e5b8d4c206a91f0e3d7b62c48e5a9f1c3d8b4072e6f0a5c9b1d3e7f84